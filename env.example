# SageWrite GraphRAG Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database
MONGODB_URL=mongodb://admin:password123@localhost:27017/sagewrite?authSource=admin
MONGODB_DB_NAME=sagewrite

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LLM Provider Selection (openai, bedrock, or vertexai)
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AWS Bedrock Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Google Vertex AI Configuration
# Required: Create a Google Cloud project, enable Vertex AI API, and create a service account
# See setup guide: https://cloud.google.com/vertex-ai/docs/start/cloud-environment
# 
# Setup Steps:
# 1. Create/select a Google Cloud project
# 2. Enable Vertex AI API (https://console.cloud.google.com/apis/library/aiplatform.googleapis.com)
# 3. Create a service account with "Vertex AI User" role
# 4. Download JSON key file for the service account
# 5. Set GOOGLE_APPLICATION_CREDENTIALS environment variable to the JSON key file path
#    OR set VERTEX_AI_CREDENTIALS_PATH below
VERTEX_AI_PROJECT_ID=your-google-cloud-project-id
VERTEX_AI_LOCATION=us-central1
# Optional: Path to service account JSON key file (alternative to GOOGLE_APPLICATION_CREDENTIALS env var)
# If not provided, will use GOOGLE_APPLICATION_CREDENTIALS environment variable
VERTEX_AI_CREDENTIALS_PATH=/path/to/service-account-key.json
# Model selection (Gemini models for LLM, textembedding-gecko for embeddings)
# Examples: gemini-pro, gemini-1.5-pro, gemini-1.5-flash
VERTEX_AI_MODEL_ID=gemini-pro
# Embedding model: textembedding-gecko@003 (768 dimensions) or textembedding-gecko-multilingual@001
VERTEX_AI_EMBEDDING_MODEL_ID=textembedding-gecko@002

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]